<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/co/lastItemOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is last item of</rdfs:label>
    <vann:example>
    :author-3 a co:ListItem ;
        co:lastItemOf :authors .
    </vann:example>
    <owl:inverseOf rdf:resource="http://purl.org/co/lastItem"/>
    <rdfs:comment xml:lang="en">The relation between an object and a list in which the object is last item.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/co/itemOf"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
  </rdf:Description>
</rdf:RDF>
