<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/co/Bag">
    <rdfs:label xml:lang="en">bag</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <rdfs:comment xml:lang="en">Collection that can have a number of copies of each object</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/co/Collection"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vann:example>
    :citations a co:Bag ;
        co:item :citation-1 , 
                :citation-2 , 
                :citation-3 ;
        co:size "3"^^xsd:nonNegativeInteger .

    :citation-1 a co:Item ; 
        co:itemContent :paper-1 .

    :citation-2 a co:Item ; 
        co:itemContent :paper-2 .

    :citation-3 a co:Item ; 
        co:itemContent :paper-1 .
    </vann:example>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <owl:disjointWith rdf:resource="http://purl.org/co/Set"/>
  </rdf:Description>
</rdf:RDF>
