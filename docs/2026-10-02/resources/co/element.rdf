  <rdf:Description rdf:about="http://purl.org/co/element">
    <rdfs:label xml:lang="en">has element</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:domain rdf:resource="http://purl.org/co/Collection"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <owl:propertyChainAxiom rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b1"/>
    <rdfs:comment xml:lang="en">The relation between a collection and the members of a collection</rdfs:comment>
    <vann:example>
    :reading-list a co:Set ;
        co:element :paper-1 , 
                :paper-2 .
    </vann:example>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b1">
    <rdf:first rdf:resource="http://purl.org/co/item"/>
    <rdf:rest rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b2"/>
  </rdf:Description>
