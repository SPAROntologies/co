<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/co/Collection">
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:subClassOf rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b5"/>
    <rdfs:subClassOf rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b6"/>
    <rdfs:label xml:lang="en">collection</rdfs:label>
    <rdfs:comment xml:lang="en">A group of objects that can be considered as a whole.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://purl.org/co/Item"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <vann:example>
    :reading-list a co:Collection ;
        co:element :paper-1 , 
                :paper-2 ;
        co:size "2"^^xsd:nonNegativeInteger .
    </vann:example>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b5">
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="http://purl.org/co/size"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nabc9bd0c26da48e5a90b3891a64505e6b6">
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://purl.org/co/element"/>
  </rdf:Description>
</rdf:RDF>
