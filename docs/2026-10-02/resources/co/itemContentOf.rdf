<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/co/itemContentOf">
    <rdfs:label xml:lang="en">is item content of</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.org/co/itemContent"/>
    <rdfs:comment xml:lang="en">The relation between an object and the item that refers to the object.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <vann:example>
    :paper-1 
        co:itemContentOf :citation-1 , 
                :citation-3 .
    </vann:example>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
</rdf:RDF>
