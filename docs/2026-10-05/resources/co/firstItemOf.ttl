@prefix co: <http://purl.org/co/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

co:firstItemOf a owl:ObjectProperty ;
    rdfs:label "is first item of"@en ;
    vann:example """
    :author-1 a co:ListItem ;
        co:firstItemOf :authors .
    """ ;
    rdfs:comment "The relation between an object and a list in which the object is first item."@en ;
    rdfs:isDefinedBy co: ;
    rdfs:subPropertyOf co:itemOf ;
    owl:inverseOf co:firstItem ;
    vs:term_status reg:statusStable .

