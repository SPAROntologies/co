[
  {
    "@id": "http://purl.org/co/followedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#TransitiveProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :author-1 \n        co:followedBy :author-2 , \n                :author-3 .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an item and the following item in a list."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://purl.org/co/ListItem"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#isDefinedBy": [
      {
        "@id": "http://purl.org/co/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "is followed by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://purl.org/co/ListItem"
      }
    ],
    "http://www.w3.org/2003/06/sw-vocab-status/ns#term_status": [
      {
        "@id": "http://purl.org/linked-data/registry#statusStable"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#note": [
      {
        "@language": "en",
        "@value": "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is followed by I[i+1], ... , I[n-1] and I[n]."
      }
    ]
  }
]