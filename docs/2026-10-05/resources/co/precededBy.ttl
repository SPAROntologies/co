@prefix co: <http://purl.org/co/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

co:precededBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "is preceded by"@en ;
    vann:example """
    :author-3 
        co:precededBy :author-2 , 
                :author-1 .
    """ ;
    rdfs:comment "The relation between an item and the preceding item in a list."@en ;
    rdfs:isDefinedBy co: ;
    owl:inverseOf co:followedBy ;
    vs:term_status reg:statusStable ;
    skos:note "Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is preceded by I[i-1], ... , I[2] and I[1]."@en .

