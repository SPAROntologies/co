    "http://purl.org/vocab/vann/example": [
      {
        "@value": "\n    :author-3 \n        co:previousItem :author-2 .\n    \n    :author-2 \n        co:previousItem :author-1 .\n    "
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The relation between an item and the previous item in a list."
