  {
    "@id": "http://purl.org/co",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/elements/1.1/contributor": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
        "@value": "Marco Ocana"
      },
      {
        "@type": "http://www.w3.org/2001/XMLSchema#string",
