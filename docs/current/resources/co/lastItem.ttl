@prefix co: <http://purl.org/co/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

co:lastItem a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has last item"@en ;
    vann:example """
    :authors a co:List ;
        co:lastItem :author-3 .
    """ ;
    rdfs:comment "The relation between an item and the last item of the list."@en ;
    rdfs:domain co:List ;
    rdfs:isDefinedBy co: ;
    rdfs:range [ a owl:Class ;
            owl:intersectionOf ( co:ListItem [ a owl:Restriction ;
                        owl:cardinality "0"^^xsd:nonNegativeInteger ;
                        owl:onProperty co:nextItem ] ) ] ;
    rdfs:subPropertyOf co:item ;
    vs:term_status reg:statusStable .

