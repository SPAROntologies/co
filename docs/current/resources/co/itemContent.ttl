@prefix co: <http://purl.org/co/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix reg: <http://purl.org/linked-data/registry#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vs: <http://www.w3.org/2003/06/sw-vocab-status/ns#> .

co:itemContent a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "has item content"@en ;
    vann:example """
    :citation-1 a co:Item ;
        co:itemContent :paper-1 .
    """ ;
    rdfs:comment "The relation between an item and the actual resource to which the item refers."@en ;
    rdfs:domain co:Item ;
    rdfs:isDefinedBy co: ;
    rdfs:range [ a owl:Class ;
            owl:complementOf co:Item ] ;
    vs:term_status reg:statusStable .

