<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
   xmlns:vann="http://purl.org/vocab/vann/"
   xmlns:vs="http://www.w3.org/2003/06/sw-vocab-status/ns#"
>
  <rdf:Description rdf:about="http://purl.org/co/precededBy">
    <rdfs:label xml:lang="en">is preceded by</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.org/co/followedBy"/>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/co/"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <vann:example>
    :author-3 
        co:precededBy :author-2 , 
                :author-1 .
    </vann:example>
    <rdfs:comment xml:lang="en">The relation between an item and the preceding item in a list.</rdfs:comment>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <skos:note xml:lang="en">Given the list (I[1], I[2], ... , I[i-1], I[i], I[i+1], ... , I[n-1], I[n]), the item I[i] is preceded by I[i-1], ... , I[2] and I[1].</skos:note>
  </rdf:Description>
</rdf:RDF>
